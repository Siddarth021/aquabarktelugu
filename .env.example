# ========================================================
# AquaBarkTelugu E-Commerce Environment Configuration
# ========================================================

# Supabase PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquabarktelugu?pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aquabarktelugu"

# Supabase Authentication & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Razorpay Payment Gateway (Test or Live)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# WhatsApp Cloud API (Optional - for order alerts)
WHATSAPP_API_TOKEN="your_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Setup Secret Token (for bootstrapping initial admin)
ADMIN_BOOTSTRAP_SECRET="aquabark-telugu-secure-setup-2026"
